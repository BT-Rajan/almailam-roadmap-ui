# ============================================================================
# ServiceOS Backend Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values.
# NEVER commit the actual .env file to version control.
# For development: Keep DEBUG=true. For production: Set DEBUG=false.
# ============================================================================

# Application Environment
ENV=development
DEBUG=true

# ============================================================================
# Server (single process, single port)
# ============================================================================
# This backend process serves both the API (/api/*) and the built frontend
# (frontend/dist) on this one port. Set by install.sh -- change it here and
# re-run install.sh (or edit this value + the pm2 ecosystem file + restart)
# if you ever need a different port; nothing else in the system needs to
# know about the port separately.
HOST=0.0.0.0
PORT=8000

# ============================================================================
# Database Configuration
# ============================================================================
# Using individual connection parameters instead of DATABASE_URL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=almailam

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================================================
# CORS Configuration
# ============================================================================
# Frontend development server URL
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ============================================================================
# JWT & Security Configuration
# ============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256

# Token expiration (in minutes for access, days for refresh)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to false if serving over plain HTTP (e.g. a bare-IP deployment
# without TLS) even when ENV=production -- otherwise the browser will
# silently refuse to store/send the refresh cookie and users get bounced
# to /login shortly after logging in. Leave unset to default to ENV.
# COOKIE_SECURE=false

# Set to "none" if the frontend and this API are on different domains
# (not just different ports of the same domain -- see CORS_ORIGINS above).
# The default "lax" cookie is silently NOT sent on cross-site fetch/XHR
# calls (only on top-level navigations), which shows up as a 401 on
# /api/auth/refresh with no cookie ever reaching the server, even once
# CORS_ORIGINS is set correctly. "none" requires COOKIE_SECURE=true (or
# ENV=production) and HTTPS -- browsers drop SameSite=None cookies that
# aren't also Secure.
# COOKIE_SAMESITE=none

# Set to the number of reverse proxies (nginx, an ALB, ...) actually
# deployed in front of this app (usually 1) if you put one there. Left at
# the default 0, the per-IP login lockout and the global rate limiter key
# off the raw TCP connection -- correct only when this process is hit
# directly. Behind an unconfigured reverse proxy, every real visitor
# shares that proxy's one IP, so a handful of concurrent users can trip
# each other's rate limit or lock each other out of login. Never set this
# unless a reverse proxy you control is actually there and actually sets
# X-Forwarded-For -- see app/core/client_ip.py for exactly how it's read.
# TRUSTED_PROXY_COUNT=1

# ============================================================================
# Authentication Security
# ============================================================================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ============================================================================
# AI Provider Credentials (optional)
# ============================================================================
# The knowledgebase Q&A tool and the New Client wizard's identification
# document check call out to a real LLM provider and need a real API key
# here to work. Without one, AI features stay honestly disabled/unavailable
# rather than faking a response -- see app/services/ai_service.py. The
# provider actually used at runtime is controlled by the Knowledgebase AI
# admin page, not by which of these happens to be set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ============================================================================
# Quick Start Setup
# ============================================================================
# 1. Create database:
#    mysql -u root -p -e "CREATE DATABASE almailam DEFAULT CHARSET=utf8mb4;"
#
# 2. Import schema:
#    mysql -u root -p almailam < schema.sql
#
# 3. Copy this file and configure:
#    cp backend/.env.example backend/.env
#
# 4. Create admin user:
#    cd backend
#    python -m scripts.create_admin --quick-start
#    # Creates: admin / Admin#99
#
# 5. Start server:
#    python -m uvicorn app.main:app --reload
#
# 6. Test at http://localhost:8000/api/health
# ============================================================================
