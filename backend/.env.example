# ============================================================================
# ServiceOS Backend Environment Configuration
# ============================================================================
# Copy this file to .env and update with your actual values.
# NEVER commit the actual .env file to version control.
# For development: Keep DEBUG=true. For production: Set DEBUG=false.
# ============================================================================

# Application Environment
ENV=development
DEBUG=true

# ============================================================================
# Database Configuration
# ============================================================================
# Using individual connection parameters instead of DATABASE_URL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=almailam

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================================================
# CORS Configuration
# ============================================================================
# Frontend development server URL
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ============================================================================
# JWT & Security Configuration
# ============================================================================
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256

# Token expiration (in minutes for access, days for refresh)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# Authentication Security
# ============================================================================
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ============================================================================
# AI Provider Credentials (optional)
# ============================================================================
# AI features (document review, contract summaries, the AI assistant) call
# out to a real LLM provider and need a real API key here to work. Without
# one, AI features stay honestly disabled/unavailable rather than faking a
# response -- see app/services/ai_service.py. The provider actually used at
# runtime is controlled by the AI Configuration admin page, not by which of
# these happens to be set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ============================================================================
# Quick Start Setup
# ============================================================================
# 1. Create database:
#    mysql -u root -p -e "CREATE DATABASE almailam DEFAULT CHARSET=utf8mb4;"
#
# 2. Import schema:
#    mysql -u root -p almailam < schema.sql
#
# 3. Copy this file and configure:
#    cp backend/.env.example backend/.env
#
# 4. Create admin user:
#    cd backend
#    python -m scripts.create_admin --quick-start
#    # Creates: admin / Admin#99
#
# 5. Start server:
#    python -m uvicorn app.main:app --reload
#
# 6. Test at http://localhost:8000/api/health
# ============================================================================
